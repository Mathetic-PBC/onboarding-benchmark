    "content": {
     "content_type": "text",
     "parts": [
      "im a GTA for cs 3604 (professionalism in computing). grading P3 which is a 1500 word case analysis. rubric has \"identifies stakeholders (10)\" \"applies ethical framework (20)\" \"argument quality (20)\" \"writing (10)\". students keep naming frameworks but not applying them. how do i give partial credit consistently on the framework row"
     ]
    },
    "status": "finished_successfully",
    "end_turn": null,
    "weight": 1.0,
    "metadata": {
     "selected_sources": [],
