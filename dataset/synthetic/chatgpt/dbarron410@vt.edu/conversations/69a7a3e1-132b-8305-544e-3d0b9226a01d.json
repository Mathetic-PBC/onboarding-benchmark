  "6d6e07eb-eff6-417d-870a-16ba88addb34": {
   "id": "6d6e07eb-eff6-417d-870a-16ba88addb34",
   "message": {
    "id": "6d6e07eb-eff6-417d-870a-16ba88addb34",
    "author": {
     "role": "assistant",
     "name": null,
