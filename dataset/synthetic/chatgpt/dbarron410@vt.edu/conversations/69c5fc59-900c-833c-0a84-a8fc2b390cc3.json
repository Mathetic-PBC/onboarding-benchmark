  "84f2662f-773f-4446-bf01-cf0df0abc1c9": {
   "id": "84f2662f-773f-4446-bf01-cf0df0abc1c9",
   "message": {
    "id": "84f2662f-773f-4446-bf01-cf0df0abc1c9",
    "author": {
     "role": "assistant",
     "name": null,
     "metadata": {}
    },
    "create_time": 1774583395.805,
    "update_time": null,
    "content": {
     "content_type": "text",
     "parts": [
      "```python\nfrom sklearn.metrics import cohen_kappa_score\nimport itertools, numpy as np\n\nwide = df.pivot(index=\"window_id\", columns=\"rater\", values=\"label\")\nraters = wide.columns\nfor state in sorted(df.label.unique()):\n    ks = [cohen_kappa_score(wide[a] == state, wide[b] == state)\n          for a, b in itertools.combinations(raters, 2)]\n    print(f\"{state:22s} {np.mean(ks):.2f}\")\n```"
     ]
    },
