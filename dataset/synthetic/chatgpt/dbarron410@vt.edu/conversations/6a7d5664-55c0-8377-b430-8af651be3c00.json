  "64822292-f246-47e5-a4aa-4fb43e32c955": {
   "id": "64822292-f246-47e5-a4aa-4fb43e32c955",
   "message": {
    "id": "64822292-f246-47e5-a4aa-4fb43e32c955",
    "author": {
     "role": "assistant",
     "name": null,
     "metadata": {}
