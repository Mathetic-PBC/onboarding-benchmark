{"parentUuid": "092a532b-e3d3-47ac-84a9-bb1f2cfdb716", "isSidechain": false, "message": {"model": "claude-opus-5", "id": "msg_01AVrwRiFkmPyEilCsFbhbLi", "type": "message", "role": "assistant", "content": [{"type": "tool_use", "id": "toolu_01QGk1EoS236xW5HdpkMNEzZ", "name": "Write", "input": {"file_path": "/Users/divadbaroon/Projects/claude-plugins/plugins/hc/scripts/hc.py", "content": "\"\"\"hc: human-driven compaction. State lives in .hc/state.json in the project.\"\"\"\nimport json, os, sys\n\nSTATE = os.path.join(\".hc\", \"state.json\")\n\n\ndef load():\n    try:\n        return json.load(open(STATE))\n    except FileNotFoundError:\n        return {\"on\": False, \"marks\": {}}\n\n\ndef save(st):\n    os.makedirs(\".hc\", exist_ok=True)\n    json.dump(st, open(STATE, \"w\"), indent=1)\n\n\ndef segments(path):\n    \"\"\"One segment per real user prompt: the prompt plus everything until the next prompt.\"\"\"\n    segs, cur = [], None\n    for line in open(path):\n        rec = json.loads(line)\n        if rec.get(\"type\") == \"user\" and isinstance(rec[\"message\"][\"content\"], str):\n            cur = {\"prompt\": rec[\"message\"][\"content\"], \"tools\": 0, \"text\": []}\n            segs.append(cur)\n        elif cur and rec.get(\"type\") == \"assistant\":\n            for b in rec[\"message\"][\"content\"]:\n                if b[\"type\"] == \"tool_use\": cur[\"tools\"] += 1\n                elif b[\"type\"] == \"text\": cur[\"text\"].append(b[\"text\"])\n    return segs\n\n\ndef main(argv):\n    st = load()\n    cmd = argv[0] if argv else \"list\"\n    if cmd == \"guard\":  # PreCompact hook: block auto-compaction while hc is on\n        if st[\"on\"]:\n            print(json.dumps({\"decision\": \"block\", \"reason\": \"hc is on: run /hc list, mark segments, then /hc write and /compact.\"}))\n        return\n    if cmd in (\"on\", \"off\"):\n        st[\"on\"] = cmd == \"on\"; save(st); print(f\"hc {cmd}\"); return\n    tpath = argv[argv.index(\"--transcript\") + 1]\n    segs = segments(tpath)\n    if cmd == \"list\":\n        for i, sg in enumerate(segs, 1):\n            mark = st[\"marks\"].get(str(i), \"-\")\n            print(f\"{i:>3} [{mark:^4}] {sg['prompt'][:80]!r} ({sg['tools']} tool calls)\")\n    elif cmd == \"mark\":\n        st[\"marks\"][argv[1]] = argv[2]; save(st); print(f\"segment {argv[1]} -> {argv[2]}\")\n    elif cmd == \"write\":\n        out = [\"# Compaction note (hc)\", \"\"]\n        for i, sg in enumerate(segs, 1):\n            m = st[\"marks\"].get(str(i), \"drop\")\n            if m == \"drop\": continue\n            out.append(f\"## {i}. {sg['prompt'][:100]}\")\n            if m == \"pin\": out.append(\"PINNED: keep verbatim.\"); out.append(sg[\"prompt\"])\n            out.append((sg[\"text\"][-1] if sg[\"text\"] else \"\")[:1200]); out.append(\"\")\n        os.makedirs(\".hc\", exist_ok=True)\n        open(\".hc/compaction-note.md\", \"w\").write(\"\\n\".join(out))\n        print(\".hc/compaction-note.md written\")\n\n\nif __name__ == \"__main__\":\n    main([a for a in sys.argv[1:]])\n"}}], "stop_reason": "tool_use", "stop_sequence": null, "usage": {"input_tokens": 3, "cache_creation_input_tokens": 2270, "cache_read_input_tokens": 30100, "output_tokens": 720, "service_tier": "standard"}}, "requestId": "req_011C3dc1S3ZAq2S6alEdDG3O", "type": "assistant", "uuid": "3e98b926-45fc-44f5-898b-e56f8cf037ce", "timestamp": "2026-08-11T06:07:07.565Z", "userType": "external", "entrypoint": "cli", "cwd": "/Users/divadbaroon/Projects/claude-plugins", "sessionId": "3a957320-906c-4f8f-9f71-519f736790d9", "version": "2.1.221", "gitBranch": "main"}
