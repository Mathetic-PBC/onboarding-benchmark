  {
   "uuid": "00329033-6e45-4e6c-bb56-7e195ca9b660",
   "text": "",
   "content": [
    {
     "start_timestamp": "2026-03-16T00:34:43.713000Z",
     "stop_timestamp": "2026-03-16T00:34:58.661000Z",
     "type": "text",
     "text": "Usually not for this situation: Virginia starts from your federal adjusted gross income, so if the 1098-T didn't change federal, it won't change state either. The main VA-specific thing to check is that state withholding on your W-2 (box 17) went in correctly.",
     "citations": []
    }
   ],
