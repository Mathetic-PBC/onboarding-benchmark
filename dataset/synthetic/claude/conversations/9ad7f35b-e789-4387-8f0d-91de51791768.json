     "stop_timestamp": "2026-03-16T00:34:41.713000Z",
     "type": "text",
     "text": "ok and VA state return, anything special for that",
     "citations": []
    }
   ],
   "sender": "human",
   "index": 4,
   "created_at": "2026-03-16T00:34:41.713000Z",
