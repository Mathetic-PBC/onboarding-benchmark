     "start_timestamp": "2026-02-22T06:11:50.622000Z",
     "stop_timestamp": "2026-02-22T06:11:50.622000Z",
     "type": "text",
     "text": "the bass too? or just eq the sample",
     "citations": []
    }
   ],
   "sender": "human",
   "index": 2,
   "created_at": "2026-02-22T06:11:50.622000Z",
