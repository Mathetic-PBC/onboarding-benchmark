  <note>
    <title>Dublin wedding — logistics</title>
    <created>20260608T010500Z</created>
    <updated>20260703T022000Z</updated>
    <tag>travel</tag>
    <tag>family</tag>
    <note-attributes>
      <author>David Barron</author>
