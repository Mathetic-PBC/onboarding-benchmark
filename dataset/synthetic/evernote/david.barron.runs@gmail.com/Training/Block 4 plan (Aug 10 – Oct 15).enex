  <note>
    <title>Block 4 plan (Aug 10 – Oct 15)</title>
    <created>20260802T214000Z</created>
    <updated>20260831T020500Z</updated>
    <tag>plan</tag>
    <tag>block-4</tag>
    <tag>half-marathon</tag>
