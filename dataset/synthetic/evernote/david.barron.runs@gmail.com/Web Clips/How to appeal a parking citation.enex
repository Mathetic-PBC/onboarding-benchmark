  <note>
    <title>How to appeal a parking citation</title>
    <created>20260302T180500Z</created>
    <updated>20260304T144000Z</updated>
    <tag>clip</tag>
    <tag>parking</tag>
    <tag>admin</tag>
    <note-attributes>
      <author>David Barron</author>
